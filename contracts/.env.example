# --- Deployment ------------------------------------------------------------------------------
# Private key of the deploying account (Base Sepolia ETH required; faucet:
# https://www.alchemy.com/faucets/base-sepolia). No 0x prefix needed either way.
PRIVATE_KEY=

# RPC endpoint. The public default works but is rate limited; use Alchemy/Infura/QuickNode for
# anything sustained, and for running the indexer.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base mainnet. The public endpoint is rate limited — use your own provider for a real deploy.
BASE_RPC_URL=https://mainnet.base.org

# Where platform fees are sent. Defaults to the deployer.
FEE_RECIPIENT=

# Owner of the launchpad. Its ONLY power is changing FEE_RECIPIENT. Defaults to the deployer.
OWNER=

# --- Verification ----------------------------------------------------------------------------
BASESCAN_API_KEY=

# --- Tooling ---------------------------------------------------------------------------------
REPORT_GAS=false
