# --- Chain ------------------------------------------------------------------------------------
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org

# Deployed launchpad. Every protocol event comes from this one address.
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Block the factory was deployed in — printed by contracts/scripts/deploy.ts.
START_BLOCK=0

# --- Indexing behaviour -------------------------------------------------------------------------
# Blocks per eth_getLogs request. Lower it if your provider complains about response size.
BLOCK_BATCH_SIZE=2000

# Blocks to stay behind the head. Base finalises quickly, but this is mainnet money — 8 blocks
# (~16s) is a reasonable trade between latency and re-org exposure.
CONFIRMATIONS=8

# How far back to rewind when a reorg is detected.
REORG_DEPTH=32

# Milliseconds between polls once caught up.
POLL_INTERVAL_MS=2000

# --- Database ---------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pumper

# --- API --------------------------------------------------------------------------------------
API_PORT=4000
API_CORS_ORIGIN=*

# Set to "true" to serve the API without running the indexer loop (e.g. a read replica).
API_ONLY=false
