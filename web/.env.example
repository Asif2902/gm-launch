# =============================================================================================
# Frontend configuration (Vite)
#
# Only VITE_-prefixed variables are inlined into the browser bundle. That is the whole reason
# the metadata API lives in ../server: Turso and R2 credentials are read there, in a process the
# browser never sees. Never put a secret in this file — it ships to every visitor.
# =============================================================================================

# Deployed launchpad on Base Sepolia — printed by contracts/scripts/deploy.ts
VITE_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Chain
VITE_CHAIN_ID=8453
VITE_RPC_URL=https://mainnet.base.org
VITE_EXPLORER_URL=https://basescan.org

# --- Off-chain metadata API (../server) --------------------------------------------------------
# Descriptions, social links, profiles, image uploads, ETH price.
# Leave as /api in development: vite.config.ts proxies it to http://localhost:4100.
# In production set the deployed origin, e.g. https://api.yourdomain.com
VITE_API_BASE=/api

# --- Market data source -------------------------------------------------------------------------
# Tried in order: subgraph → REST indexer → built-in simulation.
# Both real sources are built from the same events and expose the same entities, so the choice is
# purely operational: the subgraph needs only a URL, the REST indexer needs a Postgres you host.

# The Graph endpoint. Set this and the REST indexer is not needed at all.
#   https://api.studio.thegraph.com/query/<id>/dotfun/<version>
VITE_SUBGRAPH_URL=

# Indexer REST API (see ../indexer). Ignored when VITE_SUBGRAPH_URL is set.
VITE_INDEXER_URL=http://localhost:4000

# Force the simulated launchpad (src/lib/mock.ts) instead of calling a live source.
# Leave false for real deployments — the app falls back to demo data automatically, and labels it
# in the header, whenever the live source is unreachable.
VITE_DEMO_MODE=false
