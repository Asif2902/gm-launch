# --- server ---------------------------------------------------------------------------------
PORT=4100
CORS_ORIGIN=http://localhost:5173

# --- wallet sessions -------------------------------------------------------------------------
# One wallet signature opens a session; every off-chain write then rides on a bearer token.
#
# AUTH_SECRET signs those tokens. SET IT. Without it a random key is generated at boot, so every
# restart silently invalidates every outstanding session — users are told their session expired
# while their own countdown still shows time left, and in development `tsx watch` restarts on
# each edit so it happens constantly. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Name shown in the wallet's sign-in prompt. Use the domain users actually visit.
AUTH_DOMAIN=gm Launch
# Sessions have two bounds. The idle window slides forward while the session is in use, so an
# active user is never interrupted; the absolute cap is measured from the signature and no
# renewal can pass it. Idle capped at 7 days, absolute at 90.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# --- chain (for signature verification and the token-creator check) --------------------------
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# --- Turso (libSQL): token descriptions, social links, profiles, image records ---------------
# TURSO_URL must be the libsql:// endpoint. The JWT goes in TURSO_AUTH_TOKEN, NOT here.
TURSO_URL=
TURSO_AUTH_TOKEN=

# --- Cloudflare R2 (S3-compatible): image bytes ----------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
